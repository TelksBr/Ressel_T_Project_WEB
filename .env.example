# Veltrix Panel — API Pública
# Copie este arquivo para .env e preencha os valores

# URL da API no browser — SEMPRE use /api (proxy).
# Dev: Vite proxy  |  Produção: Cloudflare Pages Function (functions/api/)
# NÃO use https://painel.../api aqui — causa erro CORS em produção.
VITE_VELTRIX_API_BASE_URL=/api

# Slug do vendedor (token da página de vendas)
VITE_VELTRIX_SALES_SLUG=157487657359

# Token da API pública (obtenha no painel Veltrix)
# Obrigatório no build do Cloudflare Pages (variável VITE_*)
VITE_VELTRIX_PUBLIC_API_TOKEN=

# URL do painel — usado pelo proxy Vite em dev e redirecionamentos pós-compra
VITE_VELTRIX_PANEL_URL=https://painel.reselltproject.shop

# --- Cloudflare Pages (runtime da Function, opcional) ---
# VELTRIX_API_ORIGIN=https://painel.reselltproject.shop
