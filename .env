# Veltrix Panel — API Pública
# Copie este arquivo para .env e preencha os valores

# URL base da API — use /api (proxy). Não use URL absoluta do painel.
VITE_VELTRIX_API_BASE_URL=/api

# Slug do vendedor (token da página de vendas)
VITE_VELTRIX_SALES_SLUG=157487657359

# Token da API pública (obtenha no painel Veltrix)
VITE_VELTRIX_PUBLIC_API_TOKEN=veltrix_pub_b79a85096caa4486457c3ac6544ccaa53fa47a2185bef524

# URL do painel para redirecionamento pós-compra
VITE_VELTRIX_PANEL_URL=https://painel.reselltproject.shop
